{
  "id": "./",
  "name": "Don Downs Mountain Guide",
  "short_name": "Mountain Guide",
  "description": "An offline-capable Colorado mountain planning and personal summit-history app with NWS forecasts, route intelligence, expedition tools, safety prompts, and local data export.",
  "start_url": "./?source=homescreen",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#071923",
  "theme_color": "#0b2b3d",
  "categories": [
    "travel",
    "navigation",
    "sports"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Summit Focus",
      "short_name": "Focus",
      "description": "Open the field-focused summit dashboard.",
      "url": "./#focus",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Trip Intelligence",
      "short_name": "Weather",
      "description": "Open live forecasts and current-condition review tools.",
      "url": "./#intelligence",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Gear Readiness",
      "short_name": "Gear",
      "description": "Open persistent approach and summit checklists.",
      "url": "./#gear",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Emergency Plan",
      "short_name": "Emergency",
      "description": "Open communication and turnaround guidance.",
      "url": "./#emergency",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
